# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_gateway

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Mock Payment Provider ────────────────────────────────────────────────────
# Options: success | failure | timeout | random
MOCK_PROVIDER_MODE=success

# Artificial latency range in milliseconds (min-max)
MOCK_PROVIDER_LATENCY_MIN=50
MOCK_PROVIDER_LATENCY_MAX=500

# Probability of failure when mode=random (0.0 - 1.0)
MOCK_PROVIDER_FAILURE_RATE=0.1

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
