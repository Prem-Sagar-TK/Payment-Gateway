// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// IdempotencyRecord
//
// The central guard against duplicate payments. Every inbound charge request
// must first claim a row here. The UNIQUE(customerId, key) constraint is the
// database-level guarantee that only one caller wins the INSERT race.
// ─────────────────────────────────────────────────────────────────────────────
model IdempotencyRecord {
  id             String              @id @default(uuid())
  customerId     String
  key            String

  /// SHA-256 hash of the canonical request body fields.
  /// Used to detect if the caller is reusing a key for a different request.
  requestHash    String

  status         IdempotencyStatus   @default(PROCESSING)

  /// The HTTP status code of the final response (null while PROCESSING).
  responseStatus Int?

  /// The serialised payment response body stored after processing completes.
  responseBody   Json?

  /// Link to the created Payment row (null while PROCESSING or on FAILED).
  paymentId      String?
  payment        Payment?            @relation(fields: [paymentId], references: [id])

  /// How many times this key was replayed after the first successful insert.
  replayCount    Int                 @default(0)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  /// CRITICAL: This unique constraint is what prevents duplicate payments under
  /// concurrent requests. PostgreSQL will allow only one INSERT to succeed when
  /// two requests race with the same (customerId, key) pair.
  @@unique([customerId, key])
  @@index([customerId])
  @@index([key])
  @@map("idempotency_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment
//
// One row per logical payment. Created only after the IdempotencyRecord INSERT
// succeeds — so it is structurally impossible to have two Payment rows for the
// same idempotency key.
// ─────────────────────────────────────────────────────────────────────────────
model Payment {
  id                 String        @id @default(uuid())
  customerId         String
  idempotencyKey     String

  /// Amount in the smallest currency unit (e.g. paise for INR, cents for USD).
  amount             Int
  currency           String        @db.VarChar(3)
  description        String?

  status             PaymentStatus @default(PENDING)

  /// The reference returned by the payment provider (e.g. "ch_mock_abc123").
  providerReference  String?

  /// Human-readable error message when status = FAILED.
  failureReason      String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  idempotencyRecord  IdempotencyRecord[]

  @@index([customerId])
  @@index([idempotencyKey])
  @@map("payments")
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}
