generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdempotencyRecord {
  id             String              @id @default(uuid())
  customerId     String
  key            String
  requestHash    String
  status         IdempotencyStatus   @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  paymentId      String?
  payment        Payment?            @relation(fields: [paymentId], references: [id])
  replayCount    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([customerId, key])
  @@index([customerId])
  @@index([key])
  @@map("idempotency_records")
}

model Payment {
  id                 String              @id @default(uuid())
  customerId         String
  idempotencyKey     String
  amount             Int
  currency           String              @db.VarChar(3)
  description        String?
  status             PaymentStatus       @default(PENDING)
  providerReference  String?
  failureReason      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  idempotencyRecord  IdempotencyRecord[]

  @@index([customerId])
  @@index([idempotencyKey])
  @@map("payments")
}

model Employee {
  id                 String              @id @default(uuid())
  employeeId         String              @unique
  name               String
  email              String
  phone              String?
  department         String
  designation        String
  salary             Int
  currency           String              @default("INR") @db.VarChar(3)
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  status             String              @default("ACTIVE")
  paymentStatus      String              @default("PENDING")
  lastPaymentDate    DateTime?
  lastPaymentAmount  Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payrollItems       PayrollItem[]

  @@index([department])
  @@index([status])
  @@map("employees")
}

model PayrollBatch {
  id             String        @id @default(uuid())
  batchNumber    String        @unique
  title          String
  month          String?
  totalEmployees Int           @default(0)
  totalAmount    BigInt        @default(0)
  currency       String        @default("INR") @db.VarChar(3)
  status         String        @default("COMPLETED")
  successCount   Int           @default(0)
  failedCount    Int           @default(0)
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          PayrollItem[]

  @@map("payroll_batches")
}

model PayrollItem {
  id             String       @id @default(uuid())
  batchId        String
  batch          PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String       @db.VarChar(3)
  status         String       @default("SUCCEEDED")
  paymentId      String?
  idempotencyKey String?
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([batchId])
  @@index([employeeId])
  @@map("payroll_items")
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

